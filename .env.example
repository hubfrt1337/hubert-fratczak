# Endpoint formularzy (Web3Forms lub Formspree).
#
# Web3Forms  -> https://api.web3forms.com/submit   (klucz dostępu podajesz osobno, patrz niżej)
# Formspree  -> https://formspree.io/f/TWOJ_ID
NEXT_PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit

# Tylko dla Web3Forms: klucz dostępu z panelu web3forms.com (jest publiczny z założenia).
# Przy Formspree zostaw pusty.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Publiczny adres produkcyjny (używany w metadanych SEO, sitemap.xml i robots.txt)
NEXT_PUBLIC_SITE_URL=https://twoja-domena.pl
